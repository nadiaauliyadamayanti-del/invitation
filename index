<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Undangan Pernikahan - Ahmad & Siti</title>
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Montserrat:wght@300;400;600&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
    
    <!-- AOS Animation -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

    <style>
        :root {
            --maroon: #800000;
            --maroon-light: #a52a2a;
            --gold: #d4af37;
            --gold-light: #f4e4bc;
            --cream: #fffdf5;
            --wood: #5d4037;
            --dark-green: #1b3022;
            --text-dark: #333;
            --text-light: #777;
            --font-serif: 'Playfair Display', serif;
            --font-sans: 'Montserrat', sans-serif;
            --font-script: 'Great Vibes', cursive;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body {
            font-family: var(--font-sans);
            background-color: var(--cream);
            color: var(--text-dark);
            overflow-x: hidden;
            scroll-behavior: smooth;
        }

        /* Utility Classes */
        .section-padding { padding: 80px 20px; }
        .text-center { text-align: center; }
        .gold-text { color: var(--gold); }
        .maroon-text { color: var(--maroon); }

        /* Background Pattern (Mix Sasirangan & Songket) */
        .bg-pattern {
            background-image: url("https://www.transparenttextures.com/patterns/natural-paper.png");
            background-color: var(--cream);
        }

        /* --- 1. Opening / Cover --- */
        #hero {
            height: 100vh;
            width: 100%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            background: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)), url('https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&q=80&w=2000') center/cover;
            color: white;
            position: relative;
            z-index: 100;
        }

        .hero-ornament {
            position: absolute;
            width: 200px;
            opacity: 0.8;
        }
        .orn-top { top: 20px; }
        .orn-bottom { bottom: 20px; transform: rotate(180deg); }

        #hero h2 { font-family: var(--font-serif); font-size: 1.2rem; letter-spacing: 4px; text-transform: uppercase; margin-bottom: 20px; }
        #hero h1 { font-family: var(--font-script); font-size: 4rem; margin-bottom: 10px; }
        
        .btn-open {
            padding: 12px 30px;
            background: var(--gold);
            color: white;
            border: none;
            border-radius: 50px;
            cursor: pointer;
            font-weight: 600;
            transition: 0.3s;
            margin-top: 30px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        }
        .btn-open:hover { background: var(--maroon); transform: translateY(-3px); }

        /* --- 2. Quote Section --- */
        .quote-section {
            background-color: var(--cream);
            position: relative;
            overflow: hidden;
        }
        .quote-section blockquote {
            max-width: 700px;
            margin: 0 auto;
            font-family: var(--font-serif);
            font-style: italic;
            font-size: 1.1rem;
            line-height: 1.8;
            position: relative;
            z-index: 2;
        }

        /* --- 3. Bride & Groom --- */
        .profile-card {
            margin-bottom: 50px;
        }
        .img-frame {
            width: 250px;
            height: 350px;
            margin: 0 auto 20px;
            border: 8px solid var(--gold);
            padding: 10px;
            position: relative;
            overflow: hidden;
            border-radius: 150px 150px 0 0; /* Sunda Siger inspired curve */
        }
        .img-frame img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 140px 140px 0 0;
        }
        .mempelai-name { font-family: var(--font-script); font-size: 2.5rem; margin-top: 10px; }

        /* --- 4. Wedding Event --- */
        .event-card {
            background: white;
            border: 1px solid var(--gold-light);
            padding: 40px 20px;
            margin: 20px 0;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
            position: relative;
        }
        .event-card::before {
            content: '';
            position: absolute;
            top: 10px; left: 10px; right: 10px; bottom: 10px;
            border: 1px solid var(--gold-light);
            border-radius: 10px;
            pointer-events: none;
        }

        /* --- 5. Countdown --- */
        #countdown {
            background: var(--maroon);
            color: var(--gold-light);
            display: flex;
            justify-content: center;
            gap: 15px;
            padding: 40px 0;
        }
        .cd-item { text-align: center; min-width: 70px; }
        .cd-item span { display: block; font-size: 2rem; font-weight: 700; }
        .cd-item small { font-size: 0.8rem; text-transform: uppercase; }

        /* --- 6. Gallery --- */
        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            gap: 10px;
            padding: 10px;
        }
        .gallery-item img {
            width: 100%;
            height: 200px;
            object-fit: cover;
            border-radius: 8px;
            cursor: pointer;
            transition: 0.3s;
        }
        .gallery-item img:hover { transform: scale(1.03); }

        /* --- 7. RSVP & Gift --- */
        .gift-card {
            background: linear-gradient(135deg, var(--maroon), var(--maroon-light));
            color: white;
            padding: 30px;
            border-radius: 15px;
            margin-bottom: 20px;
        }
        .copy-btn {
            background: var(--gold);
            border: none;
            padding: 5px 15px;
            border-radius: 5px;
            color: white;
            cursor: pointer;
            font-size: 0.8rem;
        }

        form input, form select, form textarea {
            width: 100%;
            padding: 12px;
            margin: 10px 0;
            border: 1px solid #ddd;
            border-radius: 5px;
        }

        /* --- Floating Nav --- */
        .floating-nav {
            position: fixed;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            padding: 10px 20px;
            border-radius: 50px;
            display: flex;
            gap: 20px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
            z-index: 1000;
            border: 1px solid var(--gold);
        }
        .floating-nav a { color: var(--maroon); text-decoration: none; font-size: 1.2rem; }

        /* --- Music Button --- */
        .music-btn {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 1001;
            background: var(--gold);
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            color: white;
            cursor: pointer;
        }

        /* --- Responsive --- */
        @media (min-width: 768px) {
            .gallery-grid { grid-template-columns: repeat(4, 1fr); }
            .bride-groom-flex { display: flex; justify-content: center; gap: 100px; }
            .event-flex { display: flex; gap: 30px; justify-content: center; }
            .event-card { flex: 1; max-width: 400px; }
        }

        /* Sasirangan / Songket Pattern Element */
        .ornament-divider {
            height: 50px;
            background-image: radial-gradient(var(--gold) 1px, transparent 1px);
            background-size: 20px 20px;
            opacity: 0.3;
            margin: 20px 0;
        }
    </style>
</head>
<body class="bg-pattern">

    <!-- Music Control -->
    <div class="music-btn" onclick="toggleMusic()">
        <i id="music-icon" class="fas fa-music"></i>
    </div>
    <audio id="bg-music" loop>
        <source src="https://www.bensound.com/bensound-music/bensound-love.mp3" type="audio/mpeg">
    </audio>

    <!-- 1. Opening Section -->
    <section id="hero">
        <svg class="hero-ornament orn-top" viewBox="0 0 100 20" fill="var(--gold)">
            <path d="M0 20 Q 50 0 100 20 L 100 0 L 0 0 Z"></path>
        </svg>
        
        <div class="text-center" data-aos="fade-up">
            <h2 id="data-wedding-date-top">12 DESEMBER 2026</h2>
            <h1 id="data-mempelai-ringkas">Ahmad & Siti</h1>
            <p>Perpaduan Dua Budaya dalam Satu Cinta</p>
            <button class="btn-open" onclick="startInvitation()">Buka Undangan</button>
        </div>

        <svg class="hero-ornament orn-bottom" viewBox="0 0 100 20" fill="var(--gold)">
            <path d="M0 20 Q 50 0 100 20 L 100 0 L 0 0 Z"></path>
        </svg>
    </section>

    <!-- Main Content (Hidden initially for animation) -->
    <div id="main-content" style="display:none;">
        
        <!-- 2. Quote -->
        <section class="section-padding text-center quote-section">
            <div class="ornament-divider"></div>
            <div data-aos="fade-up">
                <blockquote id="data-quote">
                    "Dan di antara tanda-tanda (kebesaran)-Nya ialah Dia menciptakan pasangan-pasangan untukmu dari jenismu sendiri, agar kamu cenderung dan merasa tenteram kepadanya, dan Dia menjadikan di antaramu rasa kasih dan sayang."
                </blockquote>
                <p class="maroon-text" style="margin-top:20px; font-weight:600;">(Ar-Rum: 21)</p>
            </div>
        </section>

        <!-- 3. Bride & Groom -->
        <section id="mempelai" class="section-padding text-center">
            <h2 class="maroon-text" style="font-family: var(--font-serif); margin-bottom: 50px;" data-aos="fade-down">Kedua Mempelai</h2>
            
            <div class="bride-groom-flex">
                <!-- Pria -->
                <div class="profile-card" data-aos="fade-right">
                    <div class="img-frame">
                        <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?q=80&w=300" alt="Mempelai Pria">
                    </div>
                    <h3 class="mempelai-name" id="data-pria-nama">Ahmad Fadillah</h3>
                    <p>Putra dari Bapak Fulan & Ibu Fulanah</p>
                    <div style="margin-top:10px;">
                        <a href="#" class="gold-text"><i class="fab fa-instagram"></i> @ahmad_fadillah</a>
                    </div>
                </div>

                <div class="profile-card" data-aos="fade-left">
                    <div class="img-frame">
                        <img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?q=80&w=300" alt="Mempelai Wanita">
                    </div>
                    <h3 class="mempelai-name" id="data-wanita-nama">Siti Maharani</h3>
                    <p>Putri dari Bapak Fulan & Ibu Fulanah</p>
                    <div style="margin-top:10px;">
                        <a href="#" class="gold-text"><i class="fab fa-instagram"></i> @siti_maharani</a>
                    </div>
                </div>
            </div>
        </section>

        <!-- 4. Countdown -->
        <section id="countdown-section">
            <div id="countdown">
                <div class="cd-item"><span id="days">00</span><small>Hari</small></div>
                <div class="cd-item"><span id="hours">00</span><small>Jam</small></div>
                <div class="cd-item"><span id="minutes">00</span><small>Menit</small></div>
                <div class="cd-item"><span id="seconds">00</span><small>Detik</small></div>
            </div>
        </section>

        <!-- 5. Event Info -->
        <section id="acara" class="section-padding text-center">
            <h2 class="maroon-text" style="font-family: var(--font-serif); margin-bottom: 40px;" data-aos="fade-up">Rangkaian Acara</h2>
            
            <div class="event-flex">
                <div class="event-card" data-aos="zoom-in">
                    <i class="fas fa-ring gold-text" style="font-size: 2rem;"></i>
                    <h3 style="margin: 15px 0;">Akad Nikah</h3>
                    <p id="data-akad-waktu">08.00 WIB - Selesai</p>
                    <p id="data-wedding-date">Sabtu, 12 Desember 2026</p>
                    <hr style="margin: 15px 0; border: 0; border-top: 1px solid var(--gold-light);">
                    <p><b>Lokasi:</b></p>
                    <p id="data-lokasi">Grand Ballroom Example</p>
                    <p id="data-alamat" style="font-size: 0.9rem; color: var(--text-light);">Jl. Contoh No. 123, Banjarmasin</p>
                    <button class="btn-open" style="font-size: 0.8rem; padding: 8px 20px;">Lihat Lokasi</button>
                </div>

                <div class="event-card" data-aos="zoom-in" data-aos-delay="200">
                    <i class="fas fa-heart maroon-text" style="font-size: 2rem;"></i>
                    <h3 style="margin: 15px 0;">Resepsi</h3>
                    <p id="data-resepsi-waktu">11.00 - 14.00 WIB</p>
                    <p>Sabtu, 12 Desember 2026</p>
                    <hr style="margin: 15px 0; border: 0; border-top: 1px solid var(--gold-light);">
                    <p><b>Dress Code:</b></p>
                    <p>Pakaian Formal / Batik</p>
                    <p style="font-size: 0.8rem; color: var(--text-light);">Sentuhan Sasirangan / Songket diutamakan</p>
                </div>
            </div>
        </section>

        <!-- 6. Gallery -->
        <section id="gallery" class="section-padding">
            <h2 class="text-center maroon-text" style="margin-bottom: 40px; font-family: var(--font-serif);">Galeri Bahagia</h2>
            <div class="gallery-grid">
                <div class="gallery-item" data-aos="fade-up"><img src="https://images.unsplash.com/photo-1511285560929-80b456fea0bc?q=80&w=400" alt=""></div>
                <div class="gallery-item" data-aos="fade-up" data-aos-delay="100"><img src="https://images.unsplash.com/photo-1519225421980-715cb0215aed?q=80&w=400" alt=""></div>
                <div class="gallery-item" data-aos="fade-up" data-aos-delay="200"><img src="https://images.unsplash.com/photo-1583939003579-730e3918a45a?q=80&w=400" alt=""></div>
                <div class="gallery-item" data-aos="fade-up" data-aos-delay="300"><img src="https://images.unsplash.com/photo-1522673607200-164883212c2f?q=80&w=400" alt=""></div>
            </div>
        </section>

        <!-- 7. Wedding Gift -->
        <section id="gift" class="section-padding text-center bg-pattern">
            <h2 class="maroon-text" style="margin-bottom: 30px; font-family: var(--font-serif);">Kirim Hadiah</h2>
            <p style="max-width: 500px; margin: 0 auto 30px;">Doa restu Anda merupakan hadiah terindah bagi kami. Namun jika Anda ingin memberi hadiah, kami sediakan sarana berikut:</p>
            
            <div style="max-width: 400px; margin: 0 auto;">
                <div class="gift-card" data-aos="flip-up">
                    <p>Bank BCA</p>
                    <h3 style="margin: 10px 0;">1234567890</h3>
                    <p>a.n Ahmad Fadillah</p>
                    <button class="copy-btn">Salin Rekening</button>
                </div>
            </div>
        </section>

        <!-- 8. RSVP -->
        <section id="rsvp" class="section-padding">
            <div style="max-width: 600px; margin: 0 auto; background: white; padding: 40px; border-radius: 15px; box-shadow: 0 5px 20px rgba(0,0,0,0.1);">
                <h2 class="text-center maroon-text" style="margin-bottom: 30px; font-family: var(--font-serif);">Konfirmasi Kehadiran</h2>
                <form id="rsvp-form">
                    <input type="text" placeholder="Nama Lengkap" required>
                    <select required>
                        <option value="">Konfirmasi Kehadiran</option>
                        <option value="hadir">Hadir</option>
                        <option value="tidak-hadir">Tidak Hadir</option>
                    </select>
                    <input type="number" placeholder="Jumlah Tamu" min="1" max="5">
                    <textarea placeholder="Ucapan & Doa" rows="4"></textarea>
                    <button type="submit" class="btn-open" style="width: 100%;">Kirim Konfirmasi</button>
                </form>
            </div>
        </section>

        <!-- 9. Footer / Closing -->
        <footer class="section-padding text-center" style="background: var(--dark-green); color: white;">
            <p>Terima kasih atas doa dan kehadirannya</p>
            <h2 style="font-family: var(--font-script); font-size: 3rem; margin: 20px 0;">Ahmad & Siti</h2>
            <p style="font-size: 0.8rem; opacity: 0.7;">&copy; 2026 Digital Wedding Invitation - Made with Love</p>
        </footer>

        <!-- Floating Navigation -->
        <nav class="floating-nav">
            <a href="#hero" title="Home"><i class="fas fa-home"></i></a>
            <a href="#mempelai" title="Mempelai"><i class="fas fa-user-friends"></i></a>
            <a href="#acara" title="Acara"><i class="fas fa-calendar-alt"></i></a>
            <a href="#gallery" title="Galeri"><i class="fas fa-images"></i></a>
            <a href="#rsvp" title="RSVP"><i class="fas fa-edit"></i></a>
            <a href="#gift" title="Hadiah"><i class="fas fa-gift"></i></a>
        </nav>
    </div>

    <!-- Scripts -->
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        // DATA KONFIGURASI
        const WEDDING_DATA = {
            mempelaiPria: "Ahmad Fadillah",
            mempelaiWanita: "Siti Maharani",
            panggilan: "Ahmad & Siti",
            tanggal: "December 12, 2026 08:00:00",
            tglDisplay: "Sabtu, 12 Desember 2026",
            lokasi: "Grand Ballroom Example",
            alamat: "Jl. Contoh No. 123, Banjarmasin",
            akad: "08.00 WIB - Selesai",
            resepsi: "11.00 - 14.00 WIB"
        };

        // Initialize Data
        document.getElementById('data-wedding-date-top').innerText = WEDDING_DATA.tglDisplay.toUpperCase();
        document.getElementById('data-mempelai-ringkas').innerText = WEDDING_DATA.panggilan;
        document.getElementById('data-pria-nama').innerText = WEDDING_DATA.mempelaiPria;
        document.getElementById('data-wanita-nama').innerText = WEDDING_DATA.mempelaiWanita;
        document.getElementById('data-wedding-date').innerText = WEDDING_DATA.tglDisplay;
        document.getElementById('data-akad-waktu').innerText = WEDDING_DATA.akad;
        document.getElementById('data-resepsi-waktu').innerText = WEDDING_DATA.resepsi;
        document.getElementById('data-lokasi').innerText = WEDDING_DATA.lokasi;
        document.getElementById('data-alamat').innerText = WEDDING_DATA.alamat;

        // AOS Animation
        AOS.init({ duration: 1000, once: true });

        // Start Invitation Logic
        function startInvitation() {
            document.getElementById('hero').style.display = 'none';
            document.getElementById('main-content').style.display = 'block';
            toggleMusic();
            window.scrollTo(0, 0);
            AOS.refresh();
        }

        // Music Toggle Logic
        let isPlaying = false;
        const music = document.getElementById('bg-music');
        const musicIcon = document.getElementById('music-icon');

        function toggleMusic() {
            if (isPlaying) {
                music.pause();
                musicIcon.classList.replace('fa-volume-up', 'fa-music');
            } else {
                music.play();
                musicIcon.classList.replace('fa-music', 'fa-volume-up');
            }
            isPlaying = !isPlaying;
        }

        // Countdown Timer
        const countdown = () => {
            const countDate = new Date(WEDDING_DATA.tanggal).getTime();
            const now = new Date().getTime();
            const gap = countDate - now;

            const second = 1000;
            const minute = second * 60;
            const hour = minute * 60;
            const day = hour * 24;

            const d = Math.floor(gap / day);
            const h = Math.floor((gap % day) / hour);
            const m = Math.floor((gap % hour) / minute);
            const s = Math.floor((gap % minute) / second);

            document.getElementById('days').innerText = d < 10 ? '0' + d : d;
            document.getElementById('hours').innerText = h < 10 ? '0' + h : h;
            document.getElementById('minutes').innerText = m < 10 ? '0' + m : m;
            document.getElementById('seconds').innerText = s < 10 ? '0' + s : s;
        };
        setInterval(countdown, 1000);

        // RSVP Form (Simple Alert)
        document.getElementById('rsvp-form').addEventListener('submit', (e) => {
            e.preventDefault();
            alert('Terima kasih! Konfirmasi kehadiran Anda telah tersimpan.');
        });
    </script>
</body>
</html>
