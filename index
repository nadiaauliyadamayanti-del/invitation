    <script>
        // 1. LOADING SCREEN
        function finishLoad() {
            setTimeout(() => {
                document.getElementById('loader').style.opacity = '0';
                setTimeout(() => { document.getElementById('loader').style.display = 'none'; }, 800);
            }, 1500);
        }

        // 2. OPEN INVITATION
        function openInvitation() {
            document.getElementById('cover').classList.add('open');
            document.getElementById('navbar').classList.add('show');
            playMusic();
            createSakura();
            document.body.style.overflowY = "auto";
        }

        // 3. MUSIC CONTROL
        const music = document.getElementById('music');
        const icon = document.querySelector('.music-toggle i');

        function playMusic() {
            music.play().then(() => {
                document.querySelector('.music-toggle').classList.add('spin');
            }).catch(e => console.log("Audio autoplay prevented"));
        }

        function toggleMusic() {
            if (music.paused) {
                music.play();
                document.querySelector('.music-toggle').classList.add('spin');
                icon.classList.remove('fa-play'); icon.classList.add('fa-music');
            } else {
                music.pause();
                document.querySelector('.music-toggle').classList.remove('spin');
                icon.classList.remove('fa-music'); icon.classList.add('fa-play');
            }
        }

        // 4. COUNTDOWN
        const targetDate = new Date("March 29, 2026 08:00:00").getTime();
        setInterval(() => {
            const now = new Date().getTime();
            const d = targetDate - now;
            if (d > 0) {
                document.getElementById("days").innerText = Math.floor(d / (1000 * 60 * 60 * 24));
                document.getElementById("hours").innerText = Math.floor((d % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                document.getElementById("minutes").innerText = Math.floor((d % (1000 * 60 * 60)) / (1000 * 60));
                document.getElementById("seconds").innerText = Math.floor((d % (1000 * 60)) / 1000);
            }
        }, 1000);

        // 5. COPY REKENING
        function copyText(id) {
            const text = document.getElementById(id).innerText;
            navigator.clipboard.writeText(text).then(() => {
                alert("Nomor Rekening Berhasil Disalin!");
            });
        }

        // 6. SCROLL ANIMATION
        const observer = new IntersectionObserver(entries => {
            entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
        });
        document.querySelectorAll('section').forEach(s => observer.observe(s));

        // 7. ACTIVE NAVBAR LINK
        window.addEventListener('scroll', () => {
            const sections = document.querySelectorAll('section, header');
            const navLi = document.querySelectorAll('.nav-item');
            let current = '';
            sections.forEach(section => {
                const sectionTop = section.offsetTop;
                if (pageYOffset >= sectionTop - 200) { current = section.getAttribute('id'); }
            });
            navLi.forEach(li => {
                li.classList.remove('active');
                if (li.getAttribute('href').includes(current)) { li.classList.add('active'); }
            });
        });

        // 8. WHATSAPP SENDER
        function kirimWA(e) {
            e.preventDefault();
            const nama = document.getElementById('nama').value;
            const status = document.getElementById('status').value;
            const ucapan = document.getElementById('ucapan').value;
            const msg = `Halo Iqbal & Vina,%0A%0ASaya ${nama} ingin konfirmasi: ${status}.%0A%0ADoa: ${ucapan}`;
