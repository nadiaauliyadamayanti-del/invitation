<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>The Wedding of Iqbal & Vina</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Great+Vibes&family=Nunito+Sans:wght@300;400;600&display=swap"
        rel="stylesheet">

    <style>
        :root {
            --primary-gold: #c5a059;
            --primary-dark: #8a6d3b;
            --text-color: #4a4a4a;
            --bg-cream: #FDFBF7;
            --glass: rgba(255, 255, 255, 0.85);
            --shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Nunito Sans', sans-serif;
            color: var(--text-color);
            background-color: var(--bg-cream);
            overflow-x: hidden;
            background-image: url("https://www.transparenttextures.com/patterns/cream-paper.png");
        }

        h1,
        h2,
        h3 {
            font-family: 'Cormorant Garamond', serif;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        .script-font {
            font-family: 'Great Vibes', cursive;
            text-transform: none;
            font-weight: 400;
        }

        /* --- LOADING SCREEN --- */
        #loader {
            position: fixed;
            inset: 0;
            background: var(--bg-cream);
            z-index: 10000;
            display: flex;
            justify-content: center;
            align-items: center;
            flex-direction: column;
            transition: opacity 0.8s ease;
        }

        .heart-beat {
            font-size: 3rem;
            color: var(--primary-gold);
            animation: heartbeat 1.5s infinite;
        }

        @keyframes heartbeat {
            0% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.2);
            }

            100% {
                transform: scale(1);
            }
        }

        /* --- COVER (SPLASH) --- */
        #cover {
            position: fixed;
            inset: 0;
            z-index: 9999;
            background: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.4)),
                url('https://images.unsplash.com/photo-1511285560982-1351cdeb9821?ixlib=rb-1.2.1&auto=format&fit=crop&w=1950&q=80');
            background-size: cover;
            background-position: center;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            color: white;
            text-align: center;
            transition: transform 1s cubic-bezier(0.77, 0, 0.175, 1);
        }

        #cover.open {
            transform: translateY(-100%);
        }

        .btn-open {
            margin-top: 20px;
            padding: 12px 40px;
            background: var(--primary-gold);
            color: white;
            border: none;
            border-radius: 50px;
            font-size: 0.9rem;
            letter-spacing: 2px;
            cursor: pointer;
            box-shadow: 0 0 20px rgba(197, 160, 89, 0.5);
            animation: pulse 2s infinite;
        }

        /* --- NAVIGATION BAR (BOTTOM) --- */
        .navbar {
            position: fixed;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            padding: 10px 20px;
            border-radius: 50px;
            display: flex;
            gap: 20px;
            z-index: 5000;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
            border: 1px solid rgba(197, 160, 89, 0.3);
            opacity: 0;
            transition: 1s;
        }

        .navbar.show {
            opacity: 1;
        }

        .nav-item {
            color: var(--text-color);
            font-size: 1.2rem;
            transition: 0.3s;
            position: relative;
        }

        .nav-item:hover,
        .nav-item.active {
            color: var(--primary-gold);
            transform: translateY(-3px);
        }

        /* --- HERO HEADER --- */
        header {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            background: url('https://images.unsplash.com/photo-1519741497674-611481863552?ixlib=rb-1.2.1&auto=format&fit=crop&w=1950&q=80') center/cover fixed;
            position: relative;
            color: white;
            text-align: center;
        }

        header::after {
            content: '';
            position: absolute;
            inset: 0;
            background: rgba(0, 0, 0, 0.3);
        }

        .header-content {
            z-index: 2;
            border: 1px solid rgba(255, 255, 255, 0.6);
            padding: 40px;
            background: rgba(0, 0, 0, 0.2);
            backdrop-filter: blur(3px);
            border-radius: 8px;
        }

        /* --- SECTIONS UMUM --- */
        section {
            padding: 80px 20px;
            max-width: 900px;
            margin: 0 auto;
            text-align: center;
            opacity: 0;
            transform: translateY(50px);
            transition: 0.8s;
        }

        section.visible {
            opacity: 1;
            transform: translateY(0);
        }

        /* --- MEMPELAI --- */
        .couple-container {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 40px;
            margin-top: 40px;
        }

        .couple-card {
            flex: 1;
            min-width: 250px;
        }

        .img-box {
            width: 200px;
            height: 200px;
            margin: 0 auto 20px;
            border-radius: 50%;
            border: 3px solid var(--primary-gold);
            padding: 5px;
            position: relative;
        }

        .img-box img {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
        }

        .img-box::before {
            content: '\f521';
            font-family: 'Font Awesome 6 Free';
            font-weight: 900;
            position: absolute;
            top: -25px;
            left: 50%;
            transform: translateX(-50%);
            color: var(--primary-gold);
            font-size: 1.5rem;
            background: var(--bg-cream);
            padding: 0 10px;
        }

        /* --- ACARA & COUNTDOWN --- */
        .event-box {
            background: white;
            padding: 40px;
            border-radius: 10px;
            box-shadow: var(--shadow);
            border-bottom: 4px solid var(--primary-gold);
            position: relative;
            overflow: hidden;
        }

        .ribbon {
            position: absolute;
            top: 0;
            right: 0;
            width: 80px;
            height: 80px;
            overflow: hidden;
        }

        .ribbon::before {
            content: "Resepsi";
            position: absolute;
            top: 15px;
            right: -25px;
            transform: rotate(45deg);
            width: 100px;
            background: var(--primary-gold);
            color: white;
            text-align: center;
            font-size: 0.7rem;
            font-weight: bold;
            padding: 5px 0;
        }

        #countdown {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin: 30px 0;
        }

        .cd-item {
            background: var(--primary-gold);
            color: white;
            padding: 10px;
            min-width: 60px;
            border-radius: 5px;
        }

        .cd-item span {
            display: block;
            font-size: 1.2rem;
            font-weight: bold;
        }

        .cd-item small {
            font-size: 0.7rem;
        }

        /* --- GALERI --- */
        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 10px;
            margin-top: 30px;
        }

        .gallery-item {
            height: 200px;
            overflow: hidden;
            border-radius: 8px;
            cursor: pointer;
        }

        .gallery-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: 0.5s;
        }

        .gallery-item:hover img {
            transform: scale(1.1);
        }

        /* --- GIFT / AMPAO --- */
        .gift-card {
            background: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: var(--shadow);
            margin: 20px auto;
            max-width: 400px;
            text-align: left;
            border-left: 5px solid var(--primary-gold);
        }

        .bank-logo {
            font-weight: bold;
            font-size: 1.2rem;
            color: var(--primary-dark);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .copy-btn {
            background: #eee;
            border: none;
            padding: 5px 10px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 0.8rem;
        }

        .copy-btn:hover {
            background: #ddd;
        }

        /* --- EFEK BUNGA GUGUR (CSS) --- */
        .sakura {
            position: fixed;
            top: -10%;
            z-index: 9998;
            user-select: none;
            pointer-events: none;
            animation-name: fall, sway;
            animation-timing-function: linear, ease-in-out;
            animation-iteration-count: infinite, infinite;
        }

        @keyframes fall {
            0% {
                top: -10%;
            }

            100% {
                top: 100%;
            }
        }

        @keyframes sway {
            0% {
                transform: translateX(0px) rotate(0deg);
            }

            50% {
                transform: translateX(50px) rotate(180deg);
            }

            100% {
                transform: translateX(0px) rotate(360deg);
            }
        }

        /* Footer & Music */
        footer {
            background: #222;
            color: #888;
            padding: 30px;
            font-size: 0.8rem;
            margin-bottom: 70px;
        }

        .music-toggle {
            position: fixed;
            bottom: 100px;
            right: 20px;
            background: white;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.2);
            z-index: 999;
            cursor: pointer;
            color: var(--primary-gold);
        }

        .spin {
            animation: spin 3s linear infinite;
        }

        @keyframes spin {
            100% {
                transform: rotate(360deg);
            }
        }

        @keyframes pulse {
            0% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.05);
            }

            100% {
                transform: scale(1);
            }
        }
    </style>
</head>

